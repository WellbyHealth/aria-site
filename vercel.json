{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node tools/build.mjs",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/eye",
      "destination": "/specialties/ophthalmology?ref=eye",
      "permanent": false
    },
    {
      "source": "/r/:ref",
      "destination": "/?ref=:ref",
      "permanent": false
    },
    {
      "source": "/products",
      "destination": "/platform",
      "permanent": true
    },
    {
      "source": "/banking",
      "destination": "/platform",
      "permanent": true
    },
    {
      "source": "/payments",
      "destination": "/platform",
      "permanent": true
    },
    {
      "source": "/cfo",
      "destination": "/hub",
      "permanent": true
    },
    {
      "source": "/cfo-hub",
      "destination": "/hub",
      "permanent": true
    },
    {
      "source": "/treasury",
      "destination": "/platform",
      "permanent": true
    },
    {
      "source": "/expense-management",
      "destination": "/card",
      "permanent": true
    },
    {
      "source": "/bridge",
      "destination": "/lending",
      "permanent": true
    },
    {
      "source": "/claims-advance",
      "destination": "/lending",
      "permanent": true
    },
    {
      "source": "/underpayments",
      "destination": "/hub",
      "permanent": true
    },
    {
      "source": "/denials",
      "destination": "/hub",
      "permanent": true
    },
    {
      "source": "/patient-payments",
      "destination": "/hub",
      "permanent": true
    },
    {
      "source": "/bookkeeping",
      "destination": "/bill-pay",
      "permanent": true
    },
    {
      "source": "/for/veterinary",
      "destination": "/specialties",
      "permanent": true
    },
    {
      "source": "/for/pet-care",
      "destination": "/specialties",
      "permanent": true
    },
    {
      "source": "/industries/veterinary",
      "destination": "/specialties",
      "permanent": true
    },
    {
      "source": "/for/:slug",
      "destination": "/specialties/:slug",
      "permanent": true
    },
    {
      "source": "/industries/primary-care",
      "destination": "/specialties/primary-and-behavioral-care",
      "permanent": true
    },
    {
      "source": "/industries/infusion",
      "destination": "/specialties/infusion-and-buy-and-bill",
      "permanent": true
    },
    {
      "source": "/industries/:slug",
      "destination": "/specialties/:slug",
      "permanent": true
    }
  ]
}