{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node tools/build.mjs",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/eye",
      "destination": "/for/ophthalmology?ref=eye",
      "permanent": false
    },
    {
      "source": "/r/:ref",
      "destination": "/?ref=:ref",
      "permanent": false
    },
    {
      "source": "/card",
      "destination": "/banking",
      "permanent": true
    },
    {
      "source": "/treasury",
      "destination": "/banking",
      "permanent": true
    },
    {
      "source": "/expense-management",
      "destination": "/banking",
      "permanent": true
    },
    {
      "source": "/bill-pay",
      "destination": "/payments",
      "permanent": true
    },
    {
      "source": "/bridge",
      "destination": "/payments",
      "permanent": true
    },
    {
      "source": "/claims-advance",
      "destination": "/payments",
      "permanent": true
    },
    {
      "source": "/underpayments",
      "destination": "/payments",
      "permanent": true
    },
    {
      "source": "/denials",
      "destination": "/payments",
      "permanent": true
    },
    {
      "source": "/patient-payments",
      "destination": "/payments",
      "permanent": true
    },
    {
      "source": "/bookkeeping",
      "destination": "/cfo",
      "permanent": true
    },
    {
      "source": "/cfo-hub",
      "destination": "/cfo",
      "permanent": true
    }
  ]
}