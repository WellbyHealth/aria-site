{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node tools/build.mjs",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/eye",
      "destination": "/for/ophthalmology?ref=eye",
      "permanent": false
    },
    {
      "source": "/r/:ref",
      "destination": "/?ref=:ref",
      "permanent": false
    }
  ]
}